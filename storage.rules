rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /carts/{cartId}/{photo} {
      allow read: if true;

      // Only the cart's owner may upload, and only reasonably sized images.
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/carts/$(cartId))
                        .data.ownerId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
